{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portal Feature Spec",
  "type": "object",
  "required": ["id", "title", "requirements"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "status": { "type": "string" },
    "owner": { "type": "string" },
    "summary": { "type": "string" },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "description"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "priority": { "type": "string" }
        }
      }
    },
    "ui": { "type": "object" },
    "api": { "type": "object" },
    "acceptance": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
