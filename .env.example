# Copy to .env and adjust for your environment
# Gợi ý: https://api-base.local.com (API qua gateway) hoặc /api nếu gateway cùng host portal có location /api → backend.
NUXT_PUBLIC_API_BASE=https://api-base.local.com
# Dev server port for local/Docker development.
NUXT_PORT=3000
# Dashboard layout theme (default: mairy)
NUXT_PUBLIC_DASHBOARD_THEME=mairy
