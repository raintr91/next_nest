{
  "git.ignoreLimitWarning": true,

  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.pnpm-store/**": true,
    "**/.nuxt/**": true,
    "**/.nuxt-e2e/**": true,
    "**/.output/**": true,
    "**/.git/objects/**": true,
    "**/coverage/**": true,
    "**/playwright-report/**": true,
    "**/test-results/**": true,
    "**/storybook-static/**": true,
    "**/--host/**": true
  },

  "files.exclude": {
    "**/.pnpm-store": true,
    "**/--host": true
  },

  "search.exclude": {
    "**/node_modules": true,
    "**/.pnpm-store": true,
    "**/.nuxt": true,
    "**/.output": true,
    "**/coverage": true,
    "**/playwright-report": true,
    "**/test-results": true,
    "**/storybook-static": true,
    "**/--host": true
  },
  "js/ts.tsserver.maxMemory": 4096,
  "cursor.general.enableShadowWorkspace": false,
    "json.schemaDownload.enable": true
}
