# Sao chép thành portal/docker/.env
#
# Prefix tên Compose project + container (khớp API_STACK_PREFIX từng clone nếu muốn dễ đối chiếu).
PORTAL_STACK_PREFIX=base
#
# Cổng host = cổng trong container (Nuxt đọc NUXT_PORT; compose gán = PORTAL_DEV_PORT). Khớp portal:*:PORT trong docker/routes.txt.
PORTAL_DEV_PORT=3000
#
# Trùng BASE_SHARED_NETWORK_NAME trong docker/.env — portal join mạng này để gateway gọi <PORTAL_STACK_PREFIX>-portal-node.
BASE_SHARED_NETWORK_NAME=base_shared_net
#
# Trùng id -u / id -g trên host — pnpm/nuxt trong container không tạo file .nuxt (v.v.) dưới quyền root trên bind mount.
HOST_UID=1000
HOST_GID=1000
#
# Biến Nuxt/API: đặt trong portal/.env (được mount vào container), ví dụ NUXT_PUBLIC_API_BASE=/api hoặc https://api…